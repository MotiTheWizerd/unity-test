/*
 * Forge runtime editor layout: the tool strip down the left edge, the options bar across the top, the side dock
 * on the right, a status bar, and the settings card (tabs over pages). The panels, sections, fields and buttons are
 * components (UI/Controls) with their own sheets; this file only places them and styles what is particular to
 * the editor. Tokens from Theme/ForgeTokens.uss.
 */

.forge-root {
    flex-grow: 1;
}

/* ---- Docks ----------------------------------------------------------------------------------------------- */

.forge-dock {
    position: absolute;
    top: 10px;
    bottom: 46px;
}

.forge-dock--right {
    right: 10px;
    width: 340px;
}

/* While the side dock is open (SideDockSection), the assets browser stops short of it. */
.forge-root.is-side-dock-open .forge-assets {
    right: 360px;
}

/* ---- The settings card (SettingsSection): a tab bar over one page at a time ------------------------------ */

.forge-settings__tabs {
    flex-direction: row;
    margin-bottom: var(--forge-space-3);
}

.forge-settings__page {
    max-width: 480px;
}

.forge-plugin {
    color: var(--forge-text-muted);
}

.forge-plugin.is-dirty {
    color: var(--forge-accent);
}

.forge-scroll {
    flex-grow: 1;
}

/* ---- Small layout helpers ---------------------------------------------------------------------------------- */

.forge-row {
    flex-direction: row;
    align-items: center;
}

.forge-spaced {
    margin-top: var(--forge-space-1);
}

.forge-grow {
    flex-grow: 1;
}

.forge-muted {
    font-size: var(--forge-font-size-sm);
    white-space: normal;
    color: var(--forge-text-muted);
}

.forge-wrap {
    white-space: normal;
}

.forge-hidden {
    display: none;
}

.forge-time-readout {
    min-width: 44px;
    margin-left: 6px;
    -unity-text-align: middle-right;
    color: var(--forge-text-muted);
}

/* A form opened inside a section: a thin accent rule on its left. */
.forge-indented {
    margin-top: var(--forge-space-1);
    padding-left: var(--forge-space-2);
    border-left-width: 2px;
    border-color: var(--forge-accent-border);
}

/* Segmented choices: equal buttons sharing the row. */
.forge-choices > .unity-button {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 1px;
    margin-right: 1px;
}

/* The box a drag on empty space draws to select what is inside it. */
.forge-selection-box {
    position: absolute;
    border-width: 1px;
    border-color: var(--forge-accent);
    background-color: var(--forge-accent-soft);
}

/* ---- The tool strip: an icon per tool down the left edge, groups split by a thin line ---------------------- */

.forge-tool-strip {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 44px;
    padding: var(--forge-space-1);
    align-items: center;
}

.forge-tool {
    width: 34px;
    height: 34px;
    margin: 1px 0;
    border-radius: 6px;
    background-size: 18px 18px;
}

.forge-tool-strip__gap {
    width: 20px;
    height: 1px;
    margin: 5px 0;
    background-color: var(--forge-divider);
}

/* ---- The options bar across the top: a global row (the space), then the current tool's row ---------------- */

/* Centred across the screen, as wide as the tokens allow; never wider than the room between the tool strip and the edge. */
.forge-options {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    width: var(--forge-toolbar-max-width);
    max-width: 85%;
    top: 10px;
    padding: var(--forge-space-1) var(--forge-space-3);
}

.forge-options__row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-height: 30px;
}

/* The separator between the global row and the tool row sits tight; the rows carry their own height. */
.forge-options__divider {
    margin: 0 0 2px 0;
}

/* The save button fills with the accent while there are unsaved edits. */
.forge-options .is-dirty,
.forge-options .is-dirty:hover {
    background-color: var(--forge-accent);
    -unity-background-image-tint-color: var(--forge-text-on-accent);
}

.forge-options__space {
    width: 150px;
    margin-right: 2px;
}

.forge-options__name {
    margin-right: var(--forge-space-3);
    font-size: var(--forge-font-size-xs);
    -unity-font-definition: url("Fonts/Inter-Medium.ttf");
    letter-spacing: 1.5px;
    color: var(--forge-accent);
}

.forge-options__group {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.forge-options__group > * {
    margin-right: var(--forge-space-2);
}

/* Segmented choices in the bar size to their labels (the dock stretches them to share its width). */
.forge-options .forge-choices > .unity-button {
    flex-grow: 0;
    flex-basis: auto;
}

/* A value in the bar that isn't one of its buttons (the fly speed picked with the wheel), lit like the active one. */
.forge-options__accent {
    margin: 0 var(--forge-space-2);
    color: var(--forge-accent);
    -unity-font-definition: url("Fonts/Inter-Medium.ttf");
}

.forge-options__readout {
    min-width: 150px;
}

.forge-options__slider {
    width: 240px;
}

/* Fields in the bar size their label to its text; the dock's fixed label column would waste the row. */
.forge-options .unity-base-field__label {
    min-width: 0;
    width: auto;
}

/* Toggles in the bar size to their label; the dock's fixed label column would cut them off. */
.forge-options .unity-toggle > .unity-base-field__label {
    min-width: 0;
    width: auto;
}

/* ---- The side dock's Inspector page: sections stacked, scrolling when they don't fit (InspectorPage) -------- */

.forge-inspector {
    flex-grow: 1;
}

/* ---- The side dock's Materials page: the selection's parts over the library (MaterialsPage) -------------- */

.forge-material-slots {
    margin-bottom: var(--forge-space-1);
}

.forge-material-actions {
    margin-top: var(--forge-space-1);
}

/* A part of the selection (MaterialPartRow): its ball, its name, what it wears; the chosen one is lit. */
.forge-slot-row {
    flex-direction: row;
    align-items: center;
    height: 34px;
    margin: 1px 0;
    padding: 2px 8px 2px 3px;
    background-color: transparent;
    border-color: transparent;
    border-radius: var(--forge-control-radius);
    -unity-text-align: middle-left;
}

.forge-slot-row:hover:enabled {
    background-color: var(--forge-control-bg-hover);
    border-color: transparent;
}

.forge-slot-row:focus:enabled {
    border-color: transparent;
}

.forge-slot-row.is-active,
.forge-slot-row.is-active:hover:enabled,
.forge-slot-row.is-active:focus:enabled {
    background-color: var(--forge-accent-soft);
    border-color: var(--forge-accent);
}

.forge-slot-row__ball {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    justify-content: center;
    align-items: center;
    border-radius: 14px;
    background-color: var(--forge-control-bg);
    -unity-background-scale-mode: scale-to-fit;
}

.forge-slot-row__ball .forge-icon {
    width: 14px;
    height: 14px;
    -unity-background-image-tint-color: var(--forge-text-dim);
}

.forge-slot-row__name {
    flex-grow: 1;
    padding: 0;
    color: var(--forge-text);
}

.forge-slot-row__worn {
    padding: 0;
    font-size: var(--forge-font-size-sm);
    color: var(--forge-text-muted);
}

.forge-material-library__title {
    margin-bottom: var(--forge-space-1);
}

/* The library's balls flow in rows, as the assets browser's tiles do. */
.forge-material-library {
    flex-grow: 1;
}

.forge-material-library .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

/* ---- The side dock's Agent page: transcript, review bar, message box ------------------------------------- */

.forge-agent-transcript {
    flex-grow: 1;
    margin-bottom: 6px;
}

.forge-chat {
    white-space: normal;
    margin-bottom: 6px;
    padding: 5px 8px;
    border-radius: var(--forge-control-radius);
}

.forge-chat--user {
    background-color: var(--forge-accent-soft);
    color: var(--forge-text);
}

.forge-chat--activity {
    margin-bottom: 2px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: var(--forge-font-size-sm);
    color: var(--forge-success);
}

.forge-chat--notice {
    font-size: var(--forge-font-size-sm);
    -unity-font-style: italic;
    color: var(--forge-text-muted);
}

.forge-chat--error {
    color: var(--forge-danger);
}

/* Markdown in agent replies (MarkdownView). */
.forge-md__block {
    white-space: normal;
}

.forge-md__block--spaced {
    margin-top: 6px;
}

.forge-md__block--item-spaced {
    margin-top: 2px;
}

.forge-md__item {
    flex-direction: row;
}

.forge-md__marker {
    min-width: 14px;
    margin-right: 2px;
}

.forge-md__item-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.forge-md__heading {
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
}

.forge-md__code {
    padding: 4px 6px;
    border-radius: 4px;
    background-color: var(--forge-input-bg);
    color: rgb(169, 211, 255);
}

.forge-agent-mark {
    align-items: center;
    margin-bottom: 4px;
}

.forge-agent-mark-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: var(--forge-font-size-sm);
}

.forge-agent-review {
    margin-bottom: 6px;
    padding: var(--forge-space-2);
    border-radius: var(--forge-control-radius);
    border-width: 1px;
    border-color: var(--forge-accent-border);
    background-color: var(--forge-accent-soft);
}

.forge-agent-input {
    margin-left: 0;
    margin-right: 0;
    margin-top: 4px;
}

/* ---- Status bar and the fatal box ------------------------------------------------------------------------ */

.forge-status {
    position: absolute;
    left: 62px;
    right: 10px;
    bottom: 10px;
    height: 28px;
    padding: 0 var(--forge-space-3);
    -unity-text-align: middle-left;
    color: var(--forge-text-muted);
}

.forge-fatal {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 520px;
    background-color: var(--forge-danger-bg);
    border-color: transparent;
}
