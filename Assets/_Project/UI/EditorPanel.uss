/* Forge runtime editor: a dark side dock plus a status bar. */

.forge-root {
    flex-grow: 1;
    font-size: 13px;
}

.forge-root Label {
    color: rgb(222, 224, 228);
}

.forge-dock {
    position: absolute;
    left: 10px;
    top: 10px;
    bottom: 46px;
    width: 300px;
    padding: 10px;
    background-color: rgba(24, 26, 31, 0.93);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.forge-title-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.forge-title {
    font-size: 15px;
    -unity-font-style: bold;
}

.forge-plugin {
    color: rgb(150, 156, 168);
}

.forge-plugin.is-dirty {
    color: rgb(232, 176, 70);
}

.forge-scroll {
    flex-grow: 1;
}

.forge-section {
    margin-bottom: 12px;
}

.forge-section__header {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.forge-root .forge-section__header {
    color: rgb(128, 138, 156);
}

.forge-row {
    flex-direction: row;
    align-items: center;
}

.forge-spaced {
    margin-top: 4px;
}

.forge-grow {
    flex-grow: 1;
}

.forge-time-readout {
    min-width: 44px;
    margin-left: 6px;
    -unity-text-align: middle-right;
}

.forge-indented {
    margin-top: 4px;
    padding-left: 6px;
    border-left-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
}

.forge-choices > Button {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 1px;
    margin-right: 1px;
}

.forge-palette {
    flex-direction: row;
    flex-wrap: wrap;
}

.forge-palette > Button {
    width: 48%;
    margin: 1px;
}

.forge-search {
    margin-left: 0;
    margin-right: 0;
}

/* One foldout per palette category; the toggle reads as a small sub-header. */
.forge-palette-group {
    margin-top: 2px;
}

.forge-palette-group > .unity-foldout__content {
    margin-left: 4px;
}

/* Active choice: the selected tool, mode or palette entry. */
.forge-root Button.is-active {
    background-color: rgb(205, 145, 40);
    color: rgb(20, 20, 20);
    -unity-font-style: bold;
}

.forge-muted {
    font-size: 11px;
    white-space: normal;
}

.forge-root .forge-muted {
    color: rgb(156, 162, 174);
}

.forge-wrap {
    white-space: normal;
}

.forge-foldout {
    margin-top: 2px;
}

.forge-root .unity-base-field__label {
    min-width: 72px;
    width: 72px;
}

.forge-root .unity-base-slider__input-field {
    width: 48px;
}

/* Active choice inside a button made of labels (the tool strip). */
.forge-root Button.is-active Label {
    color: rgb(20, 20, 20);
}

/* The box a drag on empty space draws to select what is inside it. */
.forge-selection-box {
    position: absolute;
    border-width: 1px;
    border-color: rgb(205, 145, 40);
    background-color: rgba(205, 145, 40, 0.12);
}

/* The tool strip: one button per tool, right of the dock, groups split by a gap. */
.forge-tool-strip {
    position: absolute;
    left: 320px;
    top: 10px;
    width: 96px;
    padding: 4px;
    background-color: rgba(24, 26, 31, 0.93);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.forge-tool {
    flex-direction: row;
    justify-content: space-between;
    margin: 1px 0;
    padding: 4px 6px;
}

/* The labels sit on the light button face, so they take the button's dark text, not the panel's light one. */
.forge-root .forge-tool Label {
    color: rgb(24, 26, 31);
}

.forge-root .forge-tool .forge-tool__key {
    color: rgb(96, 104, 118);
    -unity-font-style: bold;
}

/* A tool resting while the agent's build is open reads as disabled. */
.forge-root .forge-tool:disabled Label {
    color: rgb(140, 146, 158);
}

.forge-tool-strip__gap {
    height: 8px;
}

/* The tool options bar: the current tool's name, settings and hint, across the top of the view. */
.forge-options {
    position: absolute;
    left: 426px;
    right: 360px;
    top: 10px;
    padding: 4px 10px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    background-color: rgba(24, 26, 31, 0.93);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.forge-options__name {
    margin-right: 12px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.forge-options__group {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.forge-options__group > * {
    margin-right: 8px;
}

/* Segmented choices in the bar size to their labels (the dock stretches them to share its width). */
.forge-options .forge-choices > Button {
    flex-grow: 0;
    flex-basis: auto;
}

.forge-options__readout {
    min-width: 150px;
}

.forge-options__slider {
    width: 220px;
}

.forge-options__number {
    width: 150px;
}

/* Toggles in the bar size to their label; the dock's fixed label column would cut them off. */
.forge-options .unity-toggle > .unity-base-field__label {
    min-width: 0;
    width: auto;
}

.forge-options__hint {
    width: 100%;
    margin-top: 2px;
}

/* The agent's dock, on the right: transcript, review bar, message box. */
.forge-dock--right {
    left: auto;
    right: 10px;
    width: 340px;
}

.forge-agent-transcript {
    flex-grow: 1;
    margin-bottom: 6px;
}

.forge-chat {
    white-space: normal;
    margin-bottom: 6px;
    padding: 4px 6px;
    border-radius: 4px;
}

.forge-root .forge-chat--user {
    background-color: rgba(205, 145, 40, 0.18);
    color: rgb(240, 226, 200);
}

.forge-root .forge-chat--activity {
    margin-bottom: 2px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 11px;
    color: rgb(140, 176, 150);
}

.forge-root .forge-chat--notice {
    font-size: 11px;
    -unity-font-style: italic;
    color: rgb(156, 162, 174);
}

.forge-root .forge-chat--error {
    color: rgb(240, 122, 110);
}

/* Markdown in agent replies (MarkdownView). */
.forge-md__block {
    white-space: normal;
}

.forge-md__block--spaced {
    margin-top: 6px;
}

.forge-md__block--item-spaced {
    margin-top: 2px;
}

.forge-md__item {
    flex-direction: row;
}

.forge-md__marker {
    min-width: 14px;
    margin-right: 2px;
}

.forge-md__item-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.forge-md__heading {
    -unity-font-style: bold;
}

.forge-md__code {
    padding: 4px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.25);
    color: rgb(169, 211, 255);
}

.forge-agent-mark {
    align-items: center;
    margin-bottom: 4px;
}

.forge-agent-mark-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
}

.forge-agent-review {
    margin-bottom: 6px;
    padding: 6px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(205, 145, 40, 0.55);
    background-color: rgba(205, 145, 40, 0.12);
}

.forge-agent-input {
    margin-left: 0;
    margin-right: 0;
    margin-top: 4px;
    min-height: 64px;
    max-height: 160px;
}

.forge-agent-input > .unity-text-field__input {
    -unity-text-align: upper-left;
    white-space: normal;
}

.forge-status {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    height: 28px;
    padding-left: 10px;
    padding-right: 10px;
    -unity-text-align: middle-left;
    background-color: rgba(24, 26, 31, 0.93);
    border-radius: 4px;
}

.forge-fatal {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 520px;
    padding: 12px;
    background-color: rgba(110, 28, 28, 0.95);
    border-radius: 6px;
}

.forge-hidden {
    display: none;
}
