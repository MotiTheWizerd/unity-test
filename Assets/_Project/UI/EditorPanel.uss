/*
 * Forge runtime editor layout: the editing dock on the left, the tool strip, the options bar across the top,
 * the agent dock on the right and a status bar. Colours, radii, sizes and motion come from Theme/ForgeTokens.uss;
 * the built-in controls are styled in Theme/ForgeControls.uss. This file only lays panels out and styles Forge's
 * own elements.
 */

.forge-root {
    flex-grow: 1;
}

/* ---- Panels: dark glass ------------------------------------------------------------------------------------ */

.forge-panel {
    background-color: var(--forge-panel-bg);
    border-width: 1px;
    border-color: var(--forge-panel-border);
    border-radius: var(--forge-panel-radius);
}

.forge-dock {
    position: absolute;
    left: 62px;
    top: 10px;
    bottom: 46px;
    width: 300px;
    padding: var(--forge-space-3);
}

.forge-title-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--forge-space-2);
}

.forge-title {
    font-size: var(--forge-font-size-title);
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
}

.forge-plugin {
    color: var(--forge-text-muted);
}

.forge-plugin.is-dirty {
    color: var(--forge-accent);
}

.forge-scroll {
    flex-grow: 1;
}

/* ---- Sections ------------------------------------------------------------------------------------------- */

.forge-section {
    margin-bottom: var(--forge-space-3);
    padding-bottom: var(--forge-space-2);
    border-bottom-width: 1px;
    border-color: var(--forge-divider);
}

.forge-section__header {
    font-size: var(--forge-font-size-xs);
    -unity-font-definition: url("Fonts/Inter-Medium.ttf");
    letter-spacing: 1.5px;
    margin-bottom: var(--forge-space-1);
    color: var(--forge-text-muted);
}

.forge-row {
    flex-direction: row;
    align-items: center;
}

.forge-spaced {
    margin-top: var(--forge-space-1);
}

.forge-grow {
    flex-grow: 1;
}

.forge-time-readout {
    min-width: 44px;
    margin-left: 6px;
    -unity-text-align: middle-right;
    color: var(--forge-text-muted);
}

.forge-indented {
    margin-top: var(--forge-space-1);
    padding-left: var(--forge-space-2);
    border-left-width: 2px;
    border-color: var(--forge-accent-border);
}

/* Segmented choices: equal buttons sharing the row. */
.forge-choices > Button {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 1px;
    margin-right: 1px;
}

.forge-muted {
    font-size: var(--forge-font-size-sm);
    white-space: normal;
    color: var(--forge-text-muted);
}

.forge-wrap {
    white-space: normal;
}

.forge-foldout {
    margin-top: 2px;
}

/* The box a drag on empty space draws to select what is inside it. */
.forge-selection-box {
    position: absolute;
    border-width: 1px;
    border-color: var(--forge-accent);
    background-color: var(--forge-accent-soft);
}

/* ---- The tool strip: an icon per tool down the left edge, groups split by a thin line ---------------------- */

.forge-tool-strip {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 44px;
    padding: var(--forge-space-1);
    align-items: center;
}

.forge-tool {
    width: 34px;
    height: 34px;
    margin: 1px 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    background-color: transparent;
    border-color: transparent;
    border-radius: 6px;
}

.forge-tool:hover {
    background-color: var(--forge-control-bg-hover);
}

/* This sheet sits above the theme, so the chosen tool's accent is restated here. */
.forge-tool.is-active,
.forge-tool.is-active:hover {
    background-color: var(--forge-accent);
    border-color: var(--forge-accent);
}

.forge-tool .forge-icon {
    -unity-background-image-tint-color: var(--forge-text-muted);
}

.forge-tool:hover .forge-icon {
    -unity-background-image-tint-color: var(--forge-text);
}

.forge-tool.is-active .forge-icon,
.forge-tool.is-active:hover .forge-icon {
    -unity-background-image-tint-color: var(--forge-text-on-accent);
}

.forge-tool-strip__gap {
    width: 20px;
    height: 1px;
    margin: 5px 0;
    background-color: var(--forge-divider);
}

/* The tooltip: one label at the root, placed beside the hovered element by TooltipLayer. */
.forge-tooltip {
    padding: 4px 9px;
    background-color: rgba(12, 12, 14, 0.96);
    border-width: 1px;
    border-color: var(--forge-panel-border);
    border-radius: var(--forge-control-radius);
    font-size: var(--forge-font-size-sm);
    white-space: nowrap;
}

/* ---- The tool options bar: the current tool's name, settings and hint, across the top of the view ------- */

.forge-options {
    position: absolute;
    left: 372px;
    right: 360px;
    top: 10px;
    padding: var(--forge-space-1) var(--forge-space-3);
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.forge-options__name {
    margin-right: var(--forge-space-3);
    font-size: var(--forge-font-size-xs);
    -unity-font-definition: url("Fonts/Inter-Medium.ttf");
    letter-spacing: 1.5px;
    color: var(--forge-accent);
}

.forge-options__group {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.forge-options__group > * {
    margin-right: var(--forge-space-2);
}

/* Segmented choices in the bar size to their labels (the dock stretches them to share its width). */
.forge-options .forge-choices > Button {
    flex-grow: 0;
    flex-basis: auto;
}

.forge-options__readout {
    min-width: 150px;
}

.forge-options__slider {
    width: 220px;
}

.forge-options__number {
    width: 150px;
}

/* Toggles in the bar size to their label; the dock's fixed label column would cut them off. */
.forge-options .unity-toggle > .unity-base-field__label {
    min-width: 0;
    width: auto;
}

.forge-options__hint {
    width: 100%;
    margin-top: 2px;
}

/* ---- The agent's dock, on the right: transcript, review bar, message box -------------------------------- */

.forge-dock--right {
    left: auto;
    right: 10px;
    width: 340px;
}

.forge-agent-transcript {
    flex-grow: 1;
    margin-bottom: 6px;
}

.forge-chat {
    white-space: normal;
    margin-bottom: 6px;
    padding: 5px 8px;
    border-radius: var(--forge-control-radius);
}

.forge-chat--user {
    background-color: var(--forge-accent-soft);
    color: var(--forge-text);
}

.forge-chat--activity {
    margin-bottom: 2px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: var(--forge-font-size-sm);
    color: var(--forge-success);
}

.forge-chat--notice {
    font-size: var(--forge-font-size-sm);
    -unity-font-style: italic;
    color: var(--forge-text-muted);
}

.forge-chat--error {
    color: var(--forge-danger);
}

/* Markdown in agent replies (MarkdownView). */
.forge-md__block {
    white-space: normal;
}

.forge-md__block--spaced {
    margin-top: 6px;
}

.forge-md__block--item-spaced {
    margin-top: 2px;
}

.forge-md__item {
    flex-direction: row;
}

.forge-md__marker {
    min-width: 14px;
    margin-right: 2px;
}

.forge-md__item-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.forge-md__heading {
    -unity-font-definition: url("Fonts/Inter-SemiBold.ttf");
}

.forge-md__code {
    padding: 4px 6px;
    border-radius: 4px;
    background-color: var(--forge-input-bg);
    color: rgb(169, 211, 255);
}

.forge-agent-mark {
    align-items: center;
    margin-bottom: 4px;
}

.forge-agent-mark-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: var(--forge-font-size-sm);
}

.forge-agent-review {
    margin-bottom: 6px;
    padding: var(--forge-space-2);
    border-radius: var(--forge-control-radius);
    border-width: 1px;
    border-color: var(--forge-accent-border);
    background-color: var(--forge-accent-soft);
}

.forge-agent-input {
    margin-left: 0;
    margin-right: 0;
    margin-top: 4px;
    min-height: 64px;
    max-height: 160px;
}

.forge-agent-input > .unity-text-field__input {
    -unity-text-align: upper-left;
    white-space: normal;
}

/* ---- Status bar and the fatal box ------------------------------------------------------------------------ */

.forge-status {
    position: absolute;
    left: 62px;
    right: 10px;
    bottom: 10px;
    height: 28px;
    padding-left: var(--forge-space-3);
    padding-right: var(--forge-space-3);
    -unity-text-align: middle-left;
    color: var(--forge-text-muted);
}

.forge-fatal {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 520px;
    padding: var(--forge-space-3);
    background-color: var(--forge-danger-bg);
    border-radius: var(--forge-panel-radius);
}

.forge-hidden {
    display: none;
}
