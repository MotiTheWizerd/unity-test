<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="EditorPanel.uss" />
    <Style src="AssetsBrowser.uss" />
    <ui:VisualElement name="root" class="forge-root" picking-mode="Ignore">
        <ui:VisualElement name="dock" class="forge-panel forge-dock">
            <ui:VisualElement class="forge-title-bar">
                <ui:Label name="title" class="forge-title" text="Forge Editor" />
                <ui:Label name="plugin" class="forge-plugin" />
            </ui:VisualElement>
            <ui:ScrollView name="editing" class="forge-scroll">
                <ui:VisualElement class="forge-section">
                    <ui:Label class="forge-section__header" text="SPACE" />
                    <ui:VisualElement class="forge-row">
                        <ui:DropdownField name="space-picker" class="forge-grow" />
                        <ui:Button name="space-new" text="New…" />
                    </ui:VisualElement>
                    <ui:VisualElement name="space-sea" class="forge-row">
                        <ui:Toggle name="space-sea-on" label="Sea level" />
                        <ui:FloatField name="space-sea-level" is-delayed="true" class="forge-grow" />
                        <ui:Label text="m" class="forge-muted" />
                    </ui:VisualElement>
                    <ui:DropdownField name="space-climate" label="Climate" />
                    <ui:VisualElement name="space-new-form" class="forge-indented">
                        <ui:TextField name="space-new-name" placeholder-text="Name, e.g. Whiterun or Bannered Mare" />
                        <ui:VisualElement name="space-new-kinds" class="forge-row forge-choices" />
                        <ui:VisualElement name="space-new-sizes" class="forge-row forge-choices" />
                        <ui:VisualElement class="forge-row forge-choices">
                            <ui:Button name="space-create" text="Create" />
                            <ui:Button name="space-cancel" text="Cancel" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="forge-section">
                    <ui:Label class="forge-section__header" text="TIME OF DAY" />
                    <ui:VisualElement class="forge-row">
                        <ui:Slider name="time-hour" low-value="0" high-value="24" class="forge-grow" />
                        <ui:Label name="time-readout" class="forge-time-readout" />
                    </ui:VisualElement>
                    <ui:Toggle name="time-run" label="Run (20×)" />
                    <ui:IntegerField name="time-day" label="Day" />
                    <ui:Label name="time-date" class="forge-muted" />
                    <ui:Label name="time-moons" class="forge-muted" />
                </ui:VisualElement>

                <ui:VisualElement class="forge-section">
                    <ui:Label class="forge-section__header" text="HISTORY" />
                    <ui:VisualElement class="forge-row forge-choices">
                        <ui:Button name="undo" text="Undo (Ctrl+Z)" />
                        <ui:Button name="redo" text="Redo (Ctrl+Y)" />
                    </ui:VisualElement>
                    <ui:Label name="undo-description" class="forge-muted" />
                    <ui:Button name="save" text="Save (Ctrl+S)" />
                </ui:VisualElement>

                <ui:VisualElement class="forge-section">
                    <ui:Label class="forge-section__header" text="WORLD" />
                    <ui:Label name="load-order" class="forge-muted forge-wrap" />
                    <ui:Label name="record-counts" class="forge-muted" />
                </ui:VisualElement>

                <ui:Foldout name="performance" text="Performance" value="false" class="forge-foldout">
                    <ui:Label name="performance-text" class="forge-muted" />
                </ui:Foldout>

                <ui:Foldout text="Controls" value="false" class="forge-foldout">
                    <ui:Label class="forge-muted" text="Tools: Q select · W move · E rotate · R scale · H hand&#10;P place · O outline · G fill · B sculpt · L water · M mark · Esc: back to select&#10;Outline / Fill: drag a rectangle · Shift square · [ ] turn it&#10;Click / Shift+click: select · Ctrl snaps&#10;Drag on empty space: box select (Shift adds)&#10;Move: drag objects over the ground, or the arrows&#10;Hold Space: hand in any tool&#10;Del: delete · End: drop to ground · F: frame&#10;Sculpt: hold left mouse · [ ]: brush size&#10;Water: click a hollow, drag up/down for the level · Del removes the lake&#10;1-9: place object · [ ]: rotate it (Shift: 90°)&#10;Hold + drag: paint a row · + Shift: straight line&#10;Type in Search to filter, Esc clears&#10;Ctrl+Z / Ctrl+Y: undo / redo · Ctrl+S: save&#10;Hold right mouse: look · + WASD/QE fly · Shift fast&#10;Wheel: zoom to cursor · Hold middle mouse: pan" />
                </ui:Foldout>
            </ui:ScrollView>
        </ui:VisualElement>

        <ui:VisualElement name="selection-box" class="forge-selection-box forge-hidden" picking-mode="Ignore" />

        <ui:VisualElement name="tool-strip" class="forge-panel forge-tool-strip" />

        <ui:VisualElement name="tool-options" class="forge-panel forge-options">
            <ui:Label name="tool-options-name" class="forge-options__name" />
            <ui:VisualElement name="options-selection" class="forge-options__group">
                <ui:Label name="selection-count" />
                <ui:Button name="frame-selection" text="Frame (F)" />
                <ui:Button name="drop-to-ground" text="Drop (End)" />
            </ui:VisualElement>
            <ui:VisualElement name="options-rectangle" class="forge-options__group">
                <ui:Toggle name="rectangle-snap" label="Whole pieces" />
            </ui:VisualElement>
            <ui:VisualElement name="options-place" class="forge-options__group">
                <ui:Label name="placement-rotation" class="forge-options__readout" />
                <ui:Button name="rotate-left" text="[  -15°" />
                <ui:Button name="rotate-right" text="+15°  ]" />
                <ui:Toggle name="placement-randomize" label="Random turn &amp; size" />
                <ui:Toggle name="placement-align-slope" label="Align to slope" />
                <ui:Slider name="placement-gap" label="Gap (m)" show-input-field="true" class="forge-options__slider" />
                <ui:Slider name="placement-gap-random" label="Random +" show-input-field="true" class="forge-options__slider" />
            </ui:VisualElement>
            <ui:VisualElement name="options-sculpt" class="forge-options__group">
                <ui:VisualElement name="brush-modes" class="forge-row forge-choices" />
                <ui:Slider name="brush-radius" label="Radius" show-input-field="true" class="forge-options__slider" />
                <ui:Slider name="brush-strength" label="Strength" show-input-field="true" class="forge-options__slider" />
                <ui:Toggle name="objects-follow" label="Objects follow terrain" />
            </ui:VisualElement>
            <ui:VisualElement name="options-water" class="forge-options__group">
                <ui:Label name="water-lake" />
                <ui:FloatField name="water-level" label="Level (m)" is-delayed="true" class="forge-options__number" />
                <ui:Button name="water-remove" text="Remove (Del)" />
            </ui:VisualElement>
            <ui:Label name="tool-options-hint" class="forge-muted forge-options__hint" />
        </ui:VisualElement>

        <ui:VisualElement name="assets" class="forge-panel forge-assets">
            <ui:VisualElement name="assets-resize" class="forge-assets__resize" />
            <ui:VisualElement class="forge-assets__header">
                <ui:Label class="forge-section__header forge-assets__title" text="ASSETS" />
                <ui:VisualElement name="assets-tabs" class="forge-grow" />
                <ui:Label name="assets-count" class="forge-muted forge-assets__count" />
                <ui:TextField name="assets-search" placeholder-text="Search…" class="forge-assets__search" />
                <ui:Button name="assets-collapse" class="forge-icon-button" />
            </ui:VisualElement>
            <ui:ScrollView name="assets-grid" class="forge-assets__grid" />
        </ui:VisualElement>

        <ui:VisualElement name="agent-dock" class="forge-panel forge-dock forge-dock--right">
            <ui:VisualElement class="forge-title-bar">
                <ui:Label class="forge-title" text="Agent" />
                <ui:Button name="agent-new" text="New chat" />
            </ui:VisualElement>
            <ui:ScrollView name="agent-transcript" class="forge-agent-transcript" />
            <ui:VisualElement name="agent-review" class="forge-agent-review">
                <ui:Label name="agent-review-summary" class="forge-muted forge-wrap" />
                <ui:VisualElement class="forge-row forge-choices">
                    <ui:Button name="agent-accept" text="Accept" />
                    <ui:Button name="agent-retry" text="Retry" />
                    <ui:Button name="agent-discard" text="Discard" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="agent-status" class="forge-muted" />
            <ui:VisualElement class="forge-row forge-agent-mark">
                <ui:Label name="agent-mark-text" class="forge-muted forge-wrap forge-agent-mark-text" />
                <ui:Button name="agent-mark" text="Mark (M)" />
                <ui:Button name="agent-mark-clear" text="Clear" />
            </ui:VisualElement>
            <ui:TextField name="agent-input" multiline="true" placeholder-text="Describe what to build…  (Enter sends, Shift+Enter: new line)" class="forge-agent-input" />
            <ui:VisualElement class="forge-row forge-choices">
                <ui:Button name="agent-send" text="Send" />
                <ui:Button name="agent-stop" text="Stop" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="status" class="forge-panel forge-status" />

        <ui:VisualElement name="fatal" class="forge-fatal forge-hidden">
            <ui:Label class="forge-title" text="Forge failed to start" />
            <ui:Label name="fatal-message" class="forge-wrap" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
