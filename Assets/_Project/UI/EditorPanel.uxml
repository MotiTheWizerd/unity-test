<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:forge="Forge.EditorApp.UI.Controls">
    <Style src="EditorPanel.uss" />
    <Style src="AssetsBrowser.uss" />
    <ui:VisualElement name="root" class="forge-root" picking-mode="Ignore">

        <forge:ForgePanel name="dock" class="forge-dock">
            <ui:VisualElement class="forge-panel__title-bar">
                <ui:Label name="title" class="forge-panel__title" text="Forge Editor" />
                <ui:Label name="plugin" class="forge-plugin" tooltip="The plugin your edits are saved to" />
            </ui:VisualElement>
            <ui:ScrollView name="editing" class="forge-scroll">
                <forge:ForgeSection title="SPACE">
                    <ui:VisualElement name="space-sea" class="forge-row">
                        <forge:ForgeCheckbox name="space-sea-on" label="Sea level" />
                        <forge:ForgeNumberField name="space-sea-level" unit="m" />
                    </ui:VisualElement>
                    <forge:ForgeDropdown name="space-climate" label="Climate" />
                    <ui:VisualElement name="space-new-form" class="forge-indented">
                        <forge:ForgeTextInput name="space-new-name" placeholder-text="Name, e.g. Whiterun or Bannered Mare" />
                        <ui:VisualElement name="space-new-kinds" class="forge-row forge-choices" />
                        <ui:VisualElement name="space-new-sizes" class="forge-row forge-choices" />
                        <ui:VisualElement class="forge-row forge-choices">
                            <forge:ForgeButton name="space-create" text="Create" variant="Primary" />
                            <forge:ForgeButton name="space-cancel" text="Cancel" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </forge:ForgeSection>

                <forge:ForgeSection title="TIME OF DAY">
                    <ui:VisualElement class="forge-row">
                        <ui:Slider name="time-hour" low-value="0" high-value="24" class="forge-grow" />
                        <ui:Label name="time-readout" class="forge-time-readout" />
                    </ui:VisualElement>
                    <forge:ForgeCheckbox name="time-run" label="Run (20×)" />
                    <forge:ForgeIntegerField name="time-day" label="Day" />
                    <ui:Label name="time-date" class="forge-muted" />
                    <ui:Label name="time-moons" class="forge-muted" />
                </forge:ForgeSection>

                <forge:ForgeSection title="WORLD">
                    <ui:Label name="load-order" class="forge-muted forge-wrap" />
                    <ui:Label name="record-counts" class="forge-muted" />
                </forge:ForgeSection>

                <forge:ForgeSection name="performance" title="PERFORMANCE" collapsible="true" collapsed="true">
                    <ui:Label name="performance-text" class="forge-muted" />
                </forge:ForgeSection>

                <forge:ForgeSection title="CONTROLS" collapsible="true" collapsed="true">
                    <ui:Label class="forge-muted" text="Tools: Q select · W move · E rotate · R scale · H hand&#10;P place · O outline · G fill · B sculpt · L water · M mark · Esc: back to select&#10;Outline / Fill: drag a rectangle · Shift square · [ ] turn it&#10;Click / Shift+click: select · Ctrl snaps&#10;Drag on empty space: box select (Shift adds)&#10;Move: drag objects over the ground, or the arrows&#10;Hold Space: hand in any tool&#10;Del: delete · End: drop to ground · F: frame&#10;Sculpt: hold left mouse · [ ]: brush size&#10;Water: click a hollow, drag up/down for the level · Del removes the lake&#10;1-9: place object · [ ]: rotate it (Shift: 90°)&#10;Hold + drag: paint a row · + Shift: straight line&#10;Type in Search to filter, Esc clears&#10;Ctrl+Z / Ctrl+Y: undo / redo · Ctrl+S: save&#10;Hold right mouse: look · + WASD/QE fly · Shift fast&#10;Wheel: zoom to cursor · Hold middle mouse: pan" />
                </forge:ForgeSection>
            </ui:ScrollView>
        </forge:ForgePanel>

        <ui:VisualElement name="selection-box" class="forge-selection-box forge-hidden" picking-mode="Ignore" />

        <forge:ForgePanel name="tool-strip" class="forge-tool-strip" />

        <forge:ForgePanel name="tool-options" class="forge-options">
            <ui:VisualElement class="forge-options__row forge-options__row--global">
                <ui:Label class="forge-options__name" text="SPACE" />
                <forge:ForgeDropdown name="space-picker" class="forge-options__space" tooltip="The space you are editing" />
                <forge:ForgeButton name="space-new" icon="plus" variant="Ghost" tooltip="New space…" />
                <forge:ForgeSeparator vertical="true" />
                <forge:ForgeButton name="undo" icon="undo-2" variant="Ghost" tooltip="Undo (Ctrl+Z)" />
                <forge:ForgeButton name="redo" icon="redo-2" variant="Ghost" tooltip="Redo (Ctrl+Y)" />
                <forge:ForgeSeparator vertical="true" />
                <forge:ForgeButton name="save" icon="save" variant="Ghost" tooltip="Save (Ctrl+S)" />
            </ui:VisualElement>
            <forge:ForgeSeparator class="forge-options__divider" />
            <ui:VisualElement class="forge-options__row">
            <ui:Label name="tool-options-name" class="forge-options__name" />
            <ui:VisualElement name="options-selection" class="forge-options__group">
                <ui:Label name="selection-count" />
                <forge:ForgeButton name="frame-selection" text="Frame" tooltip="F" />
                <forge:ForgeButton name="drop-to-ground" text="Drop" tooltip="End" />
            </ui:VisualElement>
            <ui:VisualElement name="options-rectangle" class="forge-options__group">
                <forge:ForgeCheckbox name="rectangle-snap" label="Whole pieces" />
            </ui:VisualElement>
            <ui:VisualElement name="options-place" class="forge-options__group">
                <ui:Label name="placement-rotation" class="forge-options__readout" />
                <forge:ForgeButton name="rotate-left" text="-15°" tooltip="[" />
                <forge:ForgeButton name="rotate-right" text="+15°" tooltip="]" />
                <forge:ForgeCheckbox name="placement-randomize" label="Random turn &amp; size" />
                <forge:ForgeCheckbox name="placement-align-slope" label="Align to slope" />
                <forge:ForgeSlider name="placement-gap" label="Gap" unit="m" class="forge-options__slider" />
                <forge:ForgeSlider name="placement-gap-random" label="Random +" unit="m" class="forge-options__slider" />
            </ui:VisualElement>
            <ui:VisualElement name="options-sculpt" class="forge-options__group">
                <ui:VisualElement name="brush-modes" class="forge-row forge-choices" />
                <forge:ForgeSlider name="brush-radius" label="Radius" unit="m" class="forge-options__slider" />
                <forge:ForgeSlider name="brush-strength" label="Strength" class="forge-options__slider" />
                <forge:ForgeCheckbox name="objects-follow" label="Objects follow terrain" />
            </ui:VisualElement>
            <ui:VisualElement name="options-water" class="forge-options__group">
                <ui:Label name="water-lake" />
                <forge:ForgeNumberField name="water-level" label="Level" unit="m" />
                <forge:ForgeButton name="water-remove" text="Remove" icon="x" tooltip="Del" />
            </ui:VisualElement>
            </ui:VisualElement>
        </forge:ForgePanel>

        <forge:ForgePanel name="assets" class="forge-assets">
            <ui:VisualElement name="assets-resize" class="forge-assets__resize" />
            <ui:VisualElement class="forge-assets__header">
                <ui:Label class="forge-section__title forge-assets__title" text="ASSETS" />
                <ui:VisualElement name="assets-tabs" class="forge-assets__tabs" />
                <ui:Label name="assets-count" class="forge-muted forge-assets__count" />
                <forge:ForgeTextInput name="assets-search" placeholder-text="Search…" class="forge-assets__search" />
                <forge:ForgeButton name="assets-collapse" variant="Ghost" tooltip="Collapse / expand" />
            </ui:VisualElement>
            <ui:ScrollView name="assets-grid" class="forge-assets__grid" />
        </forge:ForgePanel>

        <forge:ForgePanel name="agent-dock" class="forge-dock forge-dock--right">
            <ui:VisualElement class="forge-panel__title-bar">
                <ui:Label class="forge-panel__title" text="Agent" />
                <forge:ForgeButton name="agent-new" text="New chat" icon="sparkles" variant="Ghost" />
            </ui:VisualElement>
            <ui:ScrollView name="agent-transcript" class="forge-agent-transcript" />
            <ui:VisualElement name="agent-review" class="forge-agent-review">
                <ui:Label name="agent-review-summary" class="forge-muted forge-wrap" />
                <ui:VisualElement class="forge-row forge-choices">
                    <forge:ForgeButton name="agent-accept" text="Accept" variant="Primary" />
                    <forge:ForgeButton name="agent-retry" text="Retry" />
                    <forge:ForgeButton name="agent-discard" text="Discard" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="agent-status" class="forge-muted" />
            <ui:VisualElement class="forge-row forge-agent-mark">
                <ui:Label name="agent-mark-text" class="forge-muted forge-wrap forge-agent-mark-text" />
                <forge:ForgeButton name="agent-mark" text="Mark" icon="map-pin" tooltip="M" />
                <forge:ForgeButton name="agent-mark-clear" text="Clear" />
            </ui:VisualElement>
            <forge:ForgeTextArea name="agent-input" placeholder-text="Describe what to build…  (Enter sends, Shift+Enter: new line)" class="forge-agent-input" />
            <ui:VisualElement class="forge-row forge-choices">
                <forge:ForgeButton name="agent-send" text="Send" variant="Primary" />
                <forge:ForgeButton name="agent-stop" text="Stop" />
            </ui:VisualElement>
        </forge:ForgePanel>

        <ui:Label name="status" class="forge-panel forge-status" />

        <forge:ForgePanel name="fatal" class="forge-fatal forge-hidden" title="Forge failed to start">
            <ui:Label name="fatal-message" class="forge-wrap" />
        </forge:ForgePanel>
    </ui:VisualElement>
</ui:UXML>
