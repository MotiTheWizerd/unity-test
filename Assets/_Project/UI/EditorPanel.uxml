<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:forge="Forge.EditorApp.UI.Controls">
    <Style src="EditorPanel.uss" />
    <Style src="AssetsBrowser.uss" />
    <ui:VisualElement name="root" class="forge-root" picking-mode="Ignore">

        <ui:VisualElement name="selection-box" class="forge-selection-box forge-editor-chrome forge-hidden" picking-mode="Ignore" />

        <forge:ForgePanel name="tool-strip" class="forge-tool-strip forge-editor-chrome" />

        <forge:ForgePanel name="tool-options" class="forge-options forge-editor-chrome">
            <ui:VisualElement class="forge-options__row forge-options__row--global">
                <ui:Label class="forge-options__name" text="SPACE" />
                <forge:ForgeDropdown name="space-picker" class="forge-options__space" tooltip="The space you are editing" />
                <forge:ForgeButton name="space-new" icon="plus" small="true" tooltip="New space…" />
                <forge:ForgeSeparator vertical="true" />
                <forge:ForgeButton name="undo" icon="undo-2" small="true" tooltip="Undo (Ctrl+Z)" />
                <forge:ForgeButton name="redo" icon="redo-2" small="true" tooltip="Redo (Ctrl+Y)" />
                <forge:ForgeSeparator vertical="true" />
                <forge:ForgeButton name="save" icon="save" small="true" tooltip="Save (Ctrl+S)" />
                <ui:VisualElement class="forge-grow" />
                <forge:ForgeButton name="play" icon="play" small="true" tooltip="Play from here (Esc: back to editing)" />
                <forge:ForgeButton name="agent-toggle" icon="bot" small="true" tooltip="Agent" />
                <forge:ForgeButton name="settings" icon="settings" small="true" tooltip="Settings" />
            </ui:VisualElement>
            <forge:ForgeSeparator class="forge-options__divider" />
            <ui:VisualElement class="forge-options__row">
            <ui:Label name="tool-options-name" class="forge-options__name" />
            <ui:VisualElement name="options-selection" class="forge-options__group">
                <ui:Label name="selection-count" />
                <forge:ForgeButton name="frame-selection" text="Frame" tooltip="F" />
                <forge:ForgeButton name="drop-to-ground" text="Drop" tooltip="End" />
            </ui:VisualElement>
            <ui:VisualElement name="options-rectangle" class="forge-options__group">
                <forge:ForgeCheckbox name="rectangle-snap" label="Whole pieces" />
            </ui:VisualElement>
            <ui:VisualElement name="options-place" class="forge-options__group">
                <ui:Label name="placement-rotation" class="forge-options__readout" />
                <forge:ForgeButton name="rotate-left" text="-15°" tooltip="[" />
                <forge:ForgeButton name="rotate-right" text="+15°" tooltip="]" />
                <forge:ForgeCheckbox name="placement-randomize" label="Random turn &amp; size" />
                <forge:ForgeCheckbox name="placement-align-slope" label="Align to slope" />
                <forge:ForgeSlider name="placement-gap" label="Gap" unit="m" class="forge-options__slider" />
                <forge:ForgeSlider name="placement-gap-random" label="Random +" unit="m" class="forge-options__slider" />
            </ui:VisualElement>
            <ui:VisualElement name="options-sculpt" class="forge-options__group">
                <ui:VisualElement name="brush-modes" class="forge-row forge-choices" />
                <forge:ForgeSlider name="brush-radius" label="Radius" unit="m" class="forge-options__slider" />
                <forge:ForgeSlider name="brush-strength" label="Strength" class="forge-options__slider" />
                <forge:ForgeCheckbox name="objects-follow" label="Objects follow terrain" />
            </ui:VisualElement>
            <ui:VisualElement name="options-paint" class="forge-options__group">
                <ui:Label name="paint-ground" class="forge-options__readout" tooltip="The ground to paint; pick another in the assets browser's Ground tab" />
                <forge:ForgeSlider name="paint-radius" label="Radius" unit="m" class="forge-options__slider" />
                <forge:ForgeSlider name="paint-strength" label="Strength" class="forge-options__slider" />
                <forge:ForgeCheckbox name="paint-snow" label="Snow" tooltip="Auto lays snow above the snow line, except where it is too steep to hold" />
                <forge:ForgeNumberField name="paint-snow-line" label="Snow line" unit="m" tooltip="The height snow lies from; the line wanders a little and blends over about 12 m" />
                <ui:Label name="paint-land" class="forge-options__readout" tooltip="How high this space's land reaches: set the snow line below it" />
                <forge:ForgeButton name="paint-auto" text="Auto" icon="sparkles" tooltip="Paint this whole space by its shape: rock on steep ground, dirt on slopes, sand at the shore, snow above the snow line, grass elsewhere. Replaces its paint; one undo step." />
            </ui:VisualElement>
            <ui:VisualElement name="options-water" class="forge-options__group">
                <ui:Label name="water-lake" />
                <forge:ForgeNumberField name="water-level" label="Level" unit="m" />
                <forge:ForgeButton name="water-remove" text="Remove" icon="x" tooltip="Del" />
            </ui:VisualElement>
            </ui:VisualElement>
        </forge:ForgePanel>

        <ui:VisualElement name="assets-room" class="forge-assets-room" picking-mode="Ignore">
            <forge:ForgePanel name="assets" class="forge-assets forge-editor-chrome">
                <ui:VisualElement name="assets-resize" class="forge-assets__resize" />
                <ui:VisualElement class="forge-assets__header">
                    <ui:Label class="forge-section__title forge-assets__title" text="ASSETS" />
                    <ui:VisualElement name="assets-tabs" class="forge-assets__tabs" />
                    <ui:Label name="assets-count" class="forge-muted forge-assets__count" />
                    <forge:ForgeTextInput name="assets-search" placeholder-text="Search…" class="forge-assets__search" />
                    <forge:ForgeButton name="materials-toggle" icon="palette" small="true" tooltip="Materials" />
                    <forge:ForgeButton name="assets-collapse" variant="Ghost" small="true" tooltip="Collapse / expand" />
                </ui:VisualElement>
                <ui:ScrollView name="assets-grid" class="forge-assets__grid" />
            </forge:ForgePanel>
        </ui:VisualElement>

        <forge:ForgeSideDock name="side-dock" class="forge-dock forge-dock--right forge-editor-chrome forge-hidden">
            <forge:ForgeDockPage name="side-page-agent" key="agent" title="Agent" icon="bot">
                <ui:VisualElement class="forge-dock-page__bar">
                    <forge:ForgeButton name="agent-new" text="New chat" icon="sparkles" variant="Ghost" />
                </ui:VisualElement>
                <ui:ScrollView name="agent-transcript" class="forge-agent-transcript" />
                <ui:VisualElement name="agent-review" class="forge-agent-review">
                    <ui:Label name="agent-review-summary" class="forge-muted forge-wrap" />
                    <ui:VisualElement class="forge-row forge-choices">
                        <forge:ForgeButton name="agent-accept" text="Accept" variant="Primary" />
                        <forge:ForgeButton name="agent-retry" text="Retry" />
                        <forge:ForgeButton name="agent-discard" text="Discard" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="agent-status" class="forge-muted" />
                <ui:VisualElement class="forge-row forge-agent-mark">
                    <ui:Label name="agent-mark-text" class="forge-muted forge-wrap forge-agent-mark-text" />
                    <forge:ForgeButton name="agent-mark" text="Mark" icon="map-pin" tooltip="M" />
                    <forge:ForgeButton name="agent-mark-clear" text="Clear" />
                </ui:VisualElement>
                <ui:VisualElement name="agent-attachments" class="forge-agent-pictures forge-agent-attachments" />
                <forge:ForgeTextArea name="agent-input" placeholder-text="Describe what to build…  (Enter sends, Shift+Enter: new line, Ctrl+V: a picture)" class="forge-agent-input" />
                <ui:VisualElement class="forge-row forge-choices forge-agent-send-row">
                    <forge:ForgeButton name="agent-send" text="Send" variant="Primary" />
                    <forge:ForgeButton name="agent-stop" text="Stop" />
                    <forge:ForgeButton name="agent-snapshot" icon="camera" tooltip="Attach what the view shows" class="forge-agent-snapshot" />
                </ui:VisualElement>
            </forge:ForgeDockPage>
            <forge:ForgeDockPage name="side-page-inspector" key="inspector" title="Inspector" icon="info">
                <ui:Label name="inspector-empty" class="forge-muted forge-wrap" />
                <ui:ScrollView name="inspector-scroll" class="forge-inspector">
                    <ui:VisualElement name="inspector-sections" />
                </ui:ScrollView>
            </forge:ForgeDockPage>
            <forge:ForgeDockPage name="side-page-materials" key="materials" title="Materials" icon="palette">
                <forge:PreviewCard name="material-preview" />
                <forge:ForgeSection title="SELECTED OBJECT">
                    <ui:VisualElement name="material-parts" />
                    <ui:VisualElement class="forge-row forge-choices forge-material-actions">
                        <forge:ForgeButton name="make-variant" text="Make variant" tooltip="Save this object's look as a new object in the assets browser, to place more of it" />
                    </ui:VisualElement>
                    <ui:VisualElement class="forge-row forge-material-actions">
                        <forge:ForgeTextInput name="variant-name" placeholder-text="Variant name" tooltip="Enter saves, Esc cancels" class="forge-grow" />
                        <forge:ForgeButton name="variant-save" text="Save" variant="primary" />
                        <forge:ForgeButton name="variant-cancel" text="Cancel" variant="ghost" />
                    </ui:VisualElement>
                </forge:ForgeSection>
                <ui:Label class="forge-section__title forge-material-library__title" text="LIBRARY" />
                <ui:VisualElement name="material-tabs" class="forge-material-library__tabs" />
                <ui:ScrollView name="material-library" class="forge-material-library" />
            </forge:ForgeDockPage>
        </forge:ForgeSideDock>

        <ui:Label name="status" class="forge-panel forge-status forge-editor-chrome" />

        <ui:Label name="play-bar" class="forge-panel forge-play-bar" picking-mode="Ignore" text="Playing  ·  Esc: back to editing" />

        <forge:ForgePopup name="settings-popup" title="Settings">
            <ui:VisualElement name="settings-tabs" class="forge-settings__tabs" />
            <ui:ScrollView name="editing" class="forge-scroll">
                <ui:VisualElement name="settings-page-general" class="forge-settings__page">
                    <forge:ForgeSection title="WORLD">
                        <ui:VisualElement class="forge-row">
                            <ui:Label text="Saving to" />
                            <ui:Label name="plugin" class="forge-plugin" tooltip="The plugin your edits are saved to" />
                        </ui:VisualElement>
                        <ui:Label name="load-order" class="forge-muted forge-wrap" />
                        <ui:Label name="record-counts" class="forge-muted" />
                    </forge:ForgeSection>

                    <forge:ForgeSection title="CONTROLS">
                        <ui:Label class="forge-muted" text="Tools: Q select · W move · E rotate · R scale · H hand&#10;P place · O outline · G fill · B sculpt · T paint · L water · M mark · Esc: back to select&#10;Outline / Fill: drag a rectangle · Shift square · [ ] turn it&#10;Click / Shift+click or Ctrl+click: select · Ctrl snaps while dragging&#10;Drag on empty space: box select (Shift or Ctrl adds)&#10;Ctrl+A: select all · Ctrl+Shift+A: deselect · Ctrl+D: duplicate&#10;Move: drag objects over the ground, or the arrows&#10;Hold Space: hand in any tool&#10;Del: delete · End: drop to ground · F: frame&#10;Sculpt, Paint: hold left mouse · [ ]: brush size&#10;Water: click a hollow, drag up/down for the level · Del removes the lake&#10;1-9: place object · [ ]: rotate it (Shift: 90°)&#10;Hold + drag: paint a row · + Shift: straight line&#10;Type in Search to filter, Esc clears&#10;Ctrl+Z / Ctrl+Y: undo / redo · Ctrl+S: save&#10;Hold right mouse: look · + WASD/QE fly · Shift fast&#10;  + wheel: fly speed (also SPEED in the top bar)&#10;Wheel: zoom to cursor · Hold middle mouse: pan&#10;Play button (top bar): play from here · Esc: back to editing&#10;  Playing: WASD move · mouse look · Shift sprint · Space jump&#10;  F: first / third person · wheel: camera nearer / farther" />
                    </forge:ForgeSection>
                </ui:VisualElement>

                <ui:VisualElement name="settings-page-space" class="forge-settings__page">
                    <forge:ForgeSection title="SPACE">
                        <ui:VisualElement name="space-sea" class="forge-row">
                            <forge:ForgeCheckbox name="space-sea-on" label="Sea level" />
                            <forge:ForgeNumberField name="space-sea-level" unit="m" />
                        </ui:VisualElement>
                        <forge:ForgeDropdown name="space-climate" label="Climate" />
                        <ui:VisualElement name="space-land">
                            <ui:Label name="space-land-size" class="forge-muted" tooltip="The land's reach in chunks of 64 m" />
                            <ui:VisualElement class="forge-row">
                                <ui:Label text="Extend" />
                                <forge:ForgeIntegerField name="space-land-by" value="4" digits="2" tooltip="Chunks (64 m each) to add per press" />
                                <forge:ForgeButton name="space-land-north" text="N" tooltip="Extend the land north (+Z)" />
                                <forge:ForgeButton name="space-land-south" text="S" tooltip="Extend the land south (−Z)" />
                                <forge:ForgeButton name="space-land-east" text="E" tooltip="Extend the land east (+X)" />
                                <forge:ForgeButton name="space-land-west" text="W" tooltip="Extend the land west (−X)" />
                                <forge:ForgeButton name="space-land-all" text="All" tooltip="Extend the land on every side at once, corners included (one undo step)" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="space-new-form" class="forge-indented">
                            <forge:ForgeTextInput name="space-new-name" placeholder-text="Name, e.g. Whiterun or Bannered Mare" />
                            <ui:VisualElement name="space-new-kinds" class="forge-row forge-choices" />
                            <forge:ForgeDropdown name="space-new-size" label="Land" tooltip="Flat land to start with, in chunks of 64 m; extend it later" />
                            <ui:VisualElement name="space-new-spacings" class="forge-row forge-choices" tooltip="Meters between terrain height samples: 1 m for detailed land, 2 m for open country (a quarter of the data)" />
                            <ui:VisualElement class="forge-row forge-choices">
                                <forge:ForgeButton name="space-create" text="Create" variant="Primary" />
                                <forge:ForgeButton name="space-cancel" text="Cancel" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </forge:ForgeSection>
                </ui:VisualElement>

                <ui:VisualElement name="settings-page-time" class="forge-settings__page">
                    <forge:ForgeSection title="TIME OF DAY">
                        <ui:VisualElement class="forge-row">
                            <ui:Slider name="time-hour" low-value="0" high-value="24" class="forge-grow" />
                            <ui:Label name="time-readout" class="forge-time-readout" />
                        </ui:VisualElement>
                        <forge:ForgeCheckbox name="time-run" label="Run (20×)" />
                        <forge:ForgeIntegerField name="time-day" label="Day" />
                        <ui:Label name="time-date" class="forge-muted" />
                        <ui:Label name="time-moons" class="forge-muted" />
                    </forge:ForgeSection>
                </ui:VisualElement>

                <ui:VisualElement name="settings-page-camera" class="forge-settings__page">
                    <forge:ForgeSection title="FLY SPEED">
                        <ui:Label class="forge-muted forge-wrap" text="How fast the camera flies. While flying (right mouse held), the mouse wheel steps it." />
                        <ui:VisualElement class="forge-row">
                            <ui:VisualElement name="fly-speed-presets" class="forge-row forge-choices forge-grow" />
                            <ui:Label name="fly-speed-other" class="forge-options__accent" tooltip="Picked with the wheel while flying" />
                        </ui:VisualElement>
                        <forge:ForgeCheckbox name="fly-speed-height" label="By height" tooltip="Fly faster the higher you are above the ground" />
                    </forge:ForgeSection>
                </ui:VisualElement>

                <ui:VisualElement name="settings-page-performance" class="forge-settings__page">
                    <forge:ForgeSection name="performance" title="PERFORMANCE">
                        <ui:Label name="performance-text" class="forge-muted" />
                    </forge:ForgeSection>
                </ui:VisualElement>
            </ui:ScrollView>
        </forge:ForgePopup>

        <forge:ForgePanel name="fatal" class="forge-fatal forge-hidden" title="Forge failed to start">
            <ui:Label name="fatal-message" class="forge-wrap" />
        </forge:ForgePanel>
    </ui:VisualElement>
</ui:UXML>
