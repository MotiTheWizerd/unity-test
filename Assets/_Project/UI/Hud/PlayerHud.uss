/*
 * The player's HUD while playing (Forge.Play.Hud.PlayerHud): Skyrim's three bars along the bottom, magicka, health,
 * stamina, and a dot in the middle of the view with the use key's prompt under it. Each bar's fill colour is its
 * kind's (forge-hud-bar--{kind}); a mod's new bar is one more kind here.
 */

:root {
    --forge-hud-health: rgb(196, 58, 48);
    --forge-hud-stamina: rgb(86, 168, 92);
    --forge-hud-magicka: rgb(64, 118, 210);
    --forge-hud-flash: rgb(255, 236, 200);
    --forge-hud-text: rgb(244, 238, 226);
    --forge-hud-text-muted: rgba(244, 238, 226, 0.7);
    --forge-hud-shadow: rgba(0, 0, 0, 0.85);
}

.forge-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.forge-hud-bars {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 34px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

/* The middle of the view: faint, and lit while something in sight can be used. */
.forge-hud-crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    translate: -50% -50%;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.45);
}

.forge-hud-crosshair--on {
    background-color: var(--forge-hud-text);
}

/* The use key's prompt, under the middle of the view: the name, the key and what it does, a line about it. */
.forge-hud-prompt {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: 40px;
    align-items: center;
}

.forge-hud-prompt Label {
    margin: 0;
    padding: 0;
    color: var(--forge-hud-text);
    text-shadow: 1px 1px 3px var(--forge-hud-shadow);
}

.forge-hud-prompt__name {
    font-size: 20px;
    -unity-font-style: bold;
}

.forge-hud-prompt__action {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.forge-hud-prompt Label.forge-hud-prompt__key {
    min-width: 22px;
    height: 22px;
    margin-right: 8px;
    padding: 0 6px;
    border-width: 1px;
    border-color: var(--forge-hud-text);
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.45);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: none;
}

.forge-hud-prompt__verb {
    font-size: 16px;
}

.forge-hud-prompt Label.forge-hud-prompt__detail {
    margin-top: 4px;
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--forge-hud-text-muted);
}

.forge-hud-bar {
    width: 230px;
    height: 9px;
    margin: 0 var(--forge-space-4);
    padding: 1px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.28);
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0.55);
    transition-property: opacity;
    transition-duration: 0.1s;
}

.forge-hud-bar__fill {
    height: 100%;
    border-radius: 3px;
    background-color: var(--forge-text-muted);
}

.forge-hud-bar--health .forge-hud-bar__fill {
    background-color: var(--forge-hud-health);
}

.forge-hud-bar--stamina .forge-hud-bar__fill {
    background-color: var(--forge-hud-stamina);
}

.forge-hud-bar--magicka .forge-hud-bar__fill {
    background-color: var(--forge-hud-magicka);
}

/* Whoever the player last struck: its name over its health, at the top middle of the view. */
.forge-hud-target {
    position: absolute;
    left: 0;
    right: 0;
    top: 28px;
    align-items: center;
}

.forge-hud-target__name {
    margin: 0 0 4px 0;
    padding: 0;
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--forge-hud-text);
    text-shadow: 1px 1px 3px var(--forge-hud-shadow);
}

.forge-hud-target .forge-hud-bar {
    width: 300px;
}

/* Too little for a move: the frame lights up while the flash blinks on. */
.forge-hud-bar--flash {
    border-color: var(--forge-hud-flash);
    background-color: rgba(120, 30, 24, 0.75);
}
