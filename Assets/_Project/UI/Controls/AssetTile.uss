/* AssetTile: thumbnail, name, and the number key on the first nine. */

.forge-tile {
    width: 78px;
    height: 94px;
    margin: 3px;
    padding: 5px 4px 4px 4px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--forge-control-bg);
    border-color: transparent;
    border-radius: 6px;
}

/* Hover and focus sit at the :enabled specificity of Unity's theme rules, which would otherwise ring the tile. */
.forge-tile:hover:enabled {
    background-color: var(--forge-control-bg-hover);
    border-color: var(--forge-control-border);
}

.forge-tile:focus:enabled {
    border-color: transparent;
}

/* The chosen object: an accent frame rather than a filled block, so the thumbnail stays readable. */
.forge-tile.is-active,
.forge-tile.is-active:hover:enabled,
.forge-tile.is-active:focus:enabled {
    background-color: var(--forge-accent-soft);
    border-color: var(--forge-accent);
    color: var(--forge-text);
}

.forge-tile__thumb {
    width: 56px;
    height: 56px;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 4px;
}

/* A rendered picture (transparent background) fills the box; the placeholder icon is hidden then. */
.forge-tile__thumb--picture {
    -unity-background-scale-mode: scale-to-fit;
}

.forge-tile__thumb .forge-icon {
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: var(--forge-text-dim);
}

.forge-tile.is-active .forge-tile__thumb .forge-icon {
    -unity-background-image-tint-color: var(--forge-accent);
}

.forge-tile__name {
    width: 70px;
    margin-top: 5px;
    padding: 0;
    font-size: var(--forge-font-size-xs);
    color: var(--forge-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: upper-center;
}

.forge-tile.is-active .forge-tile__name {
    color: var(--forge-text);
}

.forge-tile__key {
    position: absolute;
    top: 3px;
    left: 4px;
    padding: 0 4px;
    font-size: 9px;
    -unity-font-definition: url("../Fonts/Inter-Medium.ttf");
    color: var(--forge-text-muted);
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 3px;
}
