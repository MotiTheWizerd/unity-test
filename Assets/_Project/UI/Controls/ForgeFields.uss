/*
 * Forge's fields: text input, text area, number fields, slider, checkbox, dropdown. The controls themselves are
 * Unity's, themed in Theme/ForgeControls.uss; this adds what the wrappers bring: the unit label and each field's
 * own shape.
 */

.forge-field {
    margin: 2px 0;
}

.forge-field__unit {
    margin-left: 6px;
    padding: 0;
    color: var(--forge-text-muted);
    font-size: var(--forge-font-size-sm);
    -unity-text-align: middle-left;
}

/* A text area grows with its text, between a minimum and a maximum height. */
.forge-text-area {
    min-height: 64px;
    max-height: 160px;
}

.forge-text-area > .unity-base-text-field__input {
    -unity-text-align: upper-left;
    white-space: normal;
}

/* Number boxes: bare digits, centred, no fill; a line appears under them on hover and focus. The width comes from
   the field's digits (FieldChrome.SetDigits). Sliders' number boxes carry the same class, so all numbers look alike. */
.forge-number-field {
    flex-grow: 0;
}

.forge-number-field > .unity-base-text-field__input {
    flex-grow: 0;
    padding: 3px 2px;
    background-color: transparent;
    border-color: transparent;
    border-radius: 0;
    border-bottom-color: var(--forge-divider);
    -unity-text-align: middle-center;
}

.forge-number-field > .unity-base-text-field__input:hover {
    background-color: transparent;
    border-bottom-color: var(--forge-text-dim);
}

.forge-number-field > .unity-base-text-field__input:focus:enabled,
.forge-number-field:focus:enabled > .unity-base-text-field__input {
    background-color: transparent;
    border-color: transparent;
    border-bottom-color: var(--forge-accent);
}

.forge-number-field > .unity-base-text-field__input .unity-text-element {
    -unity-text-align: middle-center;
}
