/* TabBar: a row of tabs, one current; dimmed while they don't apply (a search across all of them). */

.forge-tabs {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    transition-property: opacity;
    transition-duration: var(--forge-motion-fast);
}

.forge-tabs.is-dimmed {
    opacity: 0.4;
}

.forge-tab {
    margin: 0 2px 0 0;
    padding: 3px 10px;
    background-color: transparent;
    border-color: transparent;
    border-radius: 4px;
    color: var(--forge-text-muted);
}

/*
 * Hover and focus only change the text. Unity's theme fills a hovered button and rings a focused one with rules
 * that carry an extra :enabled state, so these restate the look at that specificity.
 */
.forge-tab:hover:enabled {
    background-color: transparent;
    border-color: transparent;
    color: var(--forge-text);
}

.forge-tab:focus:enabled {
    border-color: transparent;
}

/* The chosen tab is an accent outline: no fill, accent border and text. */
.forge-tab.is-active,
.forge-tab.is-active:hover:enabled,
.forge-tab.is-active:focus:enabled {
    background-color: transparent;
    border-width: 1px;
    border-color: var(--forge-accent);
    color: var(--forge-accent);
}
