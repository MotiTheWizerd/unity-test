/*
 * The assets browser along the bottom of the view (AssetsBrowser): header with tabs, search and collapse,
 * a grid of tiles, a drag handle on its top edge. The tabs (TabBar) and tiles (AssetTile) are components with
 * their own sheets under Controls. Tokens from Theme/ForgeTokens.uss.
 */

.forge-assets {
    position: absolute;
    left: 372px;
    right: 360px;
    bottom: 46px;
    height: 230px;
    padding: 6px 10px 8px 10px;
}

.forge-assets__resize {
    position: absolute;
    left: 0;
    right: 0;
    top: -3px;
    height: 7px;
}

.forge-assets__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--forge-space-1);
}

.forge-assets__title {
    margin: 0 var(--forge-space-3) 0 0;
}

.forge-assets__tabs {
    flex-grow: 1;
}

.forge-assets__count {
    margin: 0 var(--forge-space-2);
}

.forge-assets__search {
    width: 180px;
    margin: 0 var(--forge-space-1) 0 0;
}

/* ---- The grid --------------------------------------------------------------------------------------------- */

.forge-assets__grid {
    flex-grow: 1;
}

.forge-assets__grid .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.forge-assets__group {
    width: 100%;
    margin: 6px 0 2px 4px;
    font-size: var(--forge-font-size-xs);
    -unity-font-definition: url("Fonts/Inter-Medium.ttf");
    letter-spacing: 1px;
    color: var(--forge-text-dim);
}

/* ---- Collapsed: the header only --------------------------------------------------------------------------- */

.forge-assets.is-collapsed {
    height: auto;
}

.forge-assets.is-collapsed .forge-assets__grid {
    display: none;
}

.forge-assets.is-collapsed .forge-assets__header {
    margin-bottom: 0;
}
